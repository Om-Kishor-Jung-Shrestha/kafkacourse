# ⚠️ NOT used by `docker compose up` — docker-compose.yml sets all of these
# directly (with service hostnames like "postgres"/"pgbouncer"/"redis"/
# "kafka" instead of "localhost", since the backend runs inside the Docker
# network there). This file only matters if you run the backend directly
# on your host with `npm run start:dev`, outside Docker. To configure the
# Docker Compose stack (Google OAuth, Stripe, storage, OpenTelemetry), edit
# the `.env` file at the REPO ROOT instead (copy it from `.env.example`
# there) — see the "Quick start" section at the top of README.md.

# ─── App ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
SERVICE_NAME=multihub-backend

# ─── Database ────────────────────────────────────────────────
# No PgBouncer in the standalone/non-Docker workflow — both point at the
# same direct connection. (The Dockerized stack instead routes DATABASE_URL
# through PgBouncer for connection pooling and keeps DIRECT_DATABASE_URL
# pointed straight at Postgres for Prisma schema operations — see
# docker-compose.yml and prisma/schema.prisma's `directUrl`.)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/multihub_dev
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/multihub_dev

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev_access_secret_min_32_chars_xxxxxxx
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_refresh_secret_min_32_chars_xxxxxx
JWT_REFRESH_EXPIRES_IN=7d

# ─── Stripe (leave blank to use the local mock-checkout flow) ─
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Cloudinary (only used when STORAGE_STRATEGY=cloudinary) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── SMTP (optional — leave USER/PASS blank to use MailHog, no auth) ──
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=MultiHub
SMTP_FROM_EMAIL=noreply@multihub.dev

# ─── Google OAuth (leave blank to disable "Continue with Google") ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ─── URLs ────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BASE_URL=http://localhost:3001

# ─── Storage ─────────────────────────────────────────────────
STORAGE_STRATEGY=local
LOCAL_UPLOAD_PATH=./uploads

# ─── AWS S3 (optional, only used when STORAGE_STRATEGY=s3) ────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=

# ─── Platform ────────────────────────────────────────────────
PLATFORM_COMMISSION_PERCENT=30

# ─── BullMQ ──────────────────────────────────────────────────
BULLMQ_CONCURRENCY=2
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50

# ─── Logging (Pino) ──────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=true
METRICS_ENABLED=true

# ─── Admin ───────────────────────────────────────────────────
ADMIN_INVITE_EXPIRATION_HOURS=24
DICTIONARY_VERSION=1

# ─── OpenTelemetry ───────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=multihub-backend

# ─── Dapr ────────────────────────────────────────────────────
DAPR_ENABLED=true
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001
DAPR_APP_ID=multihub-backend
