cat > multihub/.dockerignore <<'EOF'
# Git
.git/
.gitignore

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.*.example

# Node dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.output/
coverage/

# Caches
.cache/
.turbo/
.parcel-cache/
.vite/

# Logs
logs/
*.log
npm-debug.log*

# Testing
.nyc_output/
playwright-report/
test-results/

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp

# Documentation not needed in image
*.md
!README.md
EOF