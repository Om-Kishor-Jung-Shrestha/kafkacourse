# ⚠️ NOT used by `docker compose up` — docker-compose.yml injects all of
# these directly into the frontend container's environment. This file only
# matters if you run the frontend directly on your host with `npm run dev`,
# outside Docker. To configure the Docker Compose stack, edit the `.env`
# file at the REPO ROOT instead (copy it from `.env.example` there) — see
# the "Quick start" section at the top of README.md.

# In the Dockerized stack this points at Kong (the API gateway, port 8000)
# — the frontend never calls the backend directly, only through Kong. In
# this standalone/non-Docker workflow there's no Kong running unless you
# also start the full `docker compose up` stack alongside this standalone
# frontend, so this defaults straight to the backend's own port instead
# (matches backend/.env's PORT=3001). If you DO have the full Docker stack
# (including Kong) running and just want the frontend standalone, change
# this to http://localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Server-side only (no NEXT_PUBLIC_ prefix — never reaches the browser
# bundle). Used by next.config.ts's `rewrites()` — same reasoning as
# NEXT_PUBLIC_API_URL above: points at Kong in the Docker stack, falls back
# to the backend's own port here since there's no Kong running standalone.
API_GATEWAY_URL=http://localhost:3001

NEXT_TELEMETRY_DISABLED=1

# Informational — the real Google OAuth flow is entirely server-driven (the
# "Continue with Google" button just links to the backend's
# /api/auth/google route); this is reserved for a future client-side
# Google Identity Services integration.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Informational — checkout uses Stripe's hosted Checkout page (redirect
# based), which doesn't need this. Reserved for a future Stripe.js/Elements
# integration.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
