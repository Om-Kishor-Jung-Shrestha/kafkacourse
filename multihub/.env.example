# Optional secrets for docker-compose.yml's ${VAR:-default} substitutions.
# Copy this to `.env` (same directory as docker-compose.yml — Compose reads
# it automatically, no extra flag needed) and fill in only what you want to
# enable. Everything works with this file absent entirely: Google sign-in
# stays hidden in the UI, Stripe stays in local mock-checkout mode, storage
# stays local-disk, and OpenTelemetry stays off.

# ─── Google OAuth (leave blank to disable "Continue with Google") ───────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ─── Stripe (leave blank to use the local mock-checkout flow) ───────────
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Not used server-side; only here so it's available to the frontend build
# if you later add Stripe.js/Elements (checkout itself is redirect-based
# and doesn't need this).
STRIPE_PUBLISHABLE_KEY=

# ─── SMTP (leave blank to keep using MailHog — no real email sent, no
# auth needed; view everything at http://localhost:8025 instead) ────────
# For a real provider (Gmail app password, SendGrid, etc): set all six.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=

# ─── Storage strategy (RULE-12) ──────────────────────────────────────────
# local | cloudinary | s3 — local needs nothing further configured below.
STORAGE_STRATEGY=local

# ─── Cloudinary (only used when STORAGE_STRATEGY=cloudinary) ────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── AWS S3 (only used when STORAGE_STRATEGY=s3) ─────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=

# ─── OpenTelemetry (off by default) ───────────────────────────────────────
OTEL_ENABLED=false
