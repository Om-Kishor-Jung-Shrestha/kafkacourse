cat > .gitignore <<'EOF'
# Environment variables and secrets
.env
.env.*
!.env.example
!.env.*.example

# Node.js dependencies
node_modules/
**/node_modules/

# Package manager logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.output/
coverage/

# Framework caches
.cache/
.turbo/
.parcel-cache/
.vite/
.eslintcache/
*.tsbuildinfo

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo
.DS_Store
Thumbs.db

# IDE and editor
.vscode/
.idea/
*.iml

# Testing
.nyc_output/
playwright-report/
test-results/

# Docker
.docker/

# Local databases and data
*.sqlite
*.sqlite3
*.db

# Certificates and private keys
*.pem
*.key
*.crt
*.p12
*.pfx

# OS files
.Trash-*
EOF